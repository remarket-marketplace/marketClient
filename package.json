{
  "name": "marketapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ssr": "NODE_ENV=development node server.js",
    "build": "run-p build:client build:ssr",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:client:watch": "vite build --watch",
    "build:ssr:watch": "vite build --ssr src/entry-server.ts --outDir dist/server --watch",
    "preview": "NODE_ENV=production node server.js",
    "preview:watch": "run-p build:client:watch build:ssr:watch preview:watch:server",
    "preview:watch:server": "NODE_ENV=production node --watch --watch-path=dist/server --watch-path=dist/client server.js",
    "type-check": "vue-tsc --build",
    "tw:init": "tailwindcss init -p",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.6",
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "lottie-web": "^5.13.0",
    "lucide-vue-next": "^0.552.0",
    "node-fetch": "^3.3.2",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "qrcode.vue": "^3.6.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue3-apexcharts": "^1.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@unocss/preset-icons": "^66.5.4",
    "@unocss/preset-uno": "^66.5.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.0",
    "unocss": "^66.5.4",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vue-tsc": "^3.1.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.15.0"
    }
  }
}
